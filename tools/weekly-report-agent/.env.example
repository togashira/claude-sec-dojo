# Anthropic Console (https://console.anthropic.com) で取得したAPIキーを設定してください
# Set your API key from the Anthropic Console (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 使用するモデル(任意、未指定なら claude-opus-5-5)
# Model to use (optional, defaults to claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
